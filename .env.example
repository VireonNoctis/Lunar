# ============================================================
# LUNAR BOT ENVIRONMENT
# Fill in the values below. Do not commit this file publicly.
# ============================================================

# ------------------------------------------------------------
# DISCORD
# ------------------------------------------------------------
TOKEN=your_discord_bot_token

# ------------------------------------------------------------
# LUNAR API (XP, coins, gacha, profile lookups — all routed
# through cogs/utilities/lunarapi.py). Lowercase only — nothing
# in the codebase reads uppercase LUNAR_TOKEN/LUNAR_BYPASS_TOKEN
# anymore (an older version of linkaccount.py did, which was a
# live bug: it silently ran unauthenticated if only the lowercase
# vars were set).
# ------------------------------------------------------------
lunar_token=your_lunar_api_token
bypass_token=your_lunar_bypass_token

# ------------------------------------------------------------
# LUNAR FLASK API
# ------------------------------------------------------------
LUNAR_API_HOST=0.0.0.0
LUNAR_API_PORT=8080
LUNAR_API_KEY=your_internal_api_key

# ------------------------------------------------------------
# T-MUSIC
# ------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
YOUTUBE_API_KEY=your_youtube_api_key
SOUNDCLOUD_CLIENT_ID=your_soundcloud_client_id
TMUSIC_POLL_INTERVAL_MINUTES=10

# ------------------------------------------------------------
# ERROR LOGGING
# ------------------------------------------------------------
ERROR_LOG_FILE=logs/errors.log
ERROR_LOG_COOLDOWN=15

# ------------------------------------------------------------
# DASHBOARD (OPTIONAL)
# ------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------
# DATABASE — POSTGRESQL
# cogs/utilities/database.py runs on PostgreSQL via psycopg +
# psycopg_pool. Either set DATABASE_URL as a single DSN, or set
# the individual PG*/POSTGRES_* vars below — DATABASE_URL wins
# if both are set.
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/lunar

# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=your_postgres_user
# PGPASSWORD=your_postgres_password
# PGDATABASE=lunar